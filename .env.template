# HustleXP backend local template
# Production values belong in Railway variables. Never commit populated secrets.

# Application
NODE_ENV=development
# Set separately for each process: api, worker, or attester.
SERVICE_ROLE=
HX_ENVIRONMENT=local
PORT=3000
WORKER_PORT=3001
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
SITE_URL=http://localhost:5173

# Isolated Universal V1 actor attester. The API sends the original bearer only
# over this authenticated internal transport; neither secret is browser-facing.
# Run the dedicated process with SERVICE_ROLE=attester. Its PostgreSQL URL must
# authenticate as HX_WORK_ORDER_ATTESTER_DATABASE_ROLE and is never reused by
# the API, worker, or migrator. API/worker/migration environments leave the
# attester database URL blank. All runtimes retain the eight nonsecret role
# names below for exact catalog attestation. The attester environment leaves the
# general DATABASE_URL blank; startup refuses a process that holds both roles.
ACTOR_ATTESTER_PORT=3002
HX_ACTOR_ATTESTER_URL=http://127.0.0.1:3002/internal/v1/universal-v1/actor-assertions
HX_ACTOR_ATTESTER_INTERNAL_HOST=
HX_ACTOR_ATTESTER_TIMEOUT_MS=1500
HX_ACTOR_ATTESTER_TRANSPORT_SECRET=
HX_ACTOR_ATTESTER_DATABASE_URL=

# PostgreSQL: supply only this process's enrolled LOGIN credential.
# The attester uses HX_ACTOR_ATTESTER_DATABASE_URL instead of DATABASE_URL.
DATABASE_URL=
# Replicas and transaction-mode PgBouncer are currently refused by startup.
DATABASE_REPLICA_URL=

# Independently enrolled target facts: do not derive these from the URL above.
# Startup checks the exact target digest in the authenticated release manifest,
# the current database/catalog authority, and the canonical migration bytes.
HX_RUNTIME_DATABASE_NAME=
HX_RUNTIME_DATABASE_HOST=
HX_RUNTIME_DATABASE_PORT=5432
HX_RUNTIME_DATABASE_SERVER_ADDRESS=
# disable/disabled only for approved loopback synthetic targets; remote targets
# require verify-full/require under the runtime database authority policy.
HX_RUNTIME_DATABASE_TLS_MODE=
HX_RUNTIME_DATABASE_CHANNEL_BINDING=

# Four distinct LOGIN roles and four distinct NOLOGIN owners, with no owner
# membership for runtimes. Names are metadata, not credentials or activation.
HX_WORK_ORDER_MIGRATION_DATABASE_ROLE=
HX_WORK_ORDER_API_DATABASE_ROLE=
HX_WORK_ORDER_WORKER_DATABASE_ROLE=
HX_WORK_ORDER_ATTESTER_DATABASE_ROLE=
HX_WORK_ORDER_COMMAND_OWNER_DATABASE_ROLE=
HX_WORK_ORDER_ASSERTION_OWNER_DATABASE_ROLE=
HX_FINANCE_COMMAND_OWNER_DATABASE_ROLE=
HX_TELEMETRY_OWNER_DATABASE_ROLE=

# Exact release/build evidence and approved public signer enrollment are also
# required. A populated template or an arbitrary manifest is not authority.
HX_RELEASE_MANIFEST_PATH=
HX_RELEASE_MANIFEST_SIGNATURE_PATH=
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000
DB_PGBOUNCER=false

# Redis: provider-neutral TCP for cache, rate limits, BullMQ, and realtime.
# This loopback URL is for repository-only host diagnostics. The canonical
# hustlexp-platform stack supplies its own private, synthetic Redis address.
# This repository's docker-compose.yml is an intentionally non-runnable pointer.
REDIS_URL=redis://localhost:6379
# Backwards-compatible TCP alias only. Leave blank when REDIS_URL is set.
UPSTASH_REDIS_URL=
# Optional legacy REST alternate. Both values are required to select it;
# neither is inferred from REDIS_URL, REDIS_URL wins, and there is no failover.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QUEUE_HMAC_SECRET=

# Firebase authentication
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_WEB_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_MODE=test
HX_PAYMENT_CREATION_MODE=frozen
# Hard assignment is independently deny-by-default. The only enabled path is
# further constrained to isolated test execution by HardAssignmentGuard.
HX_HARD_ASSIGNMENT_MODE=frozen
HX_STRIPE_STUB=0
PLATFORM_FEE_PERCENT=20
MIN_TASK_VALUE_CENTS=1500
STRIPE_FREE_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Encryption: use independent keys. Location keys are base64; TIN/session keys are hex.
TASK_LOCATION_ENCRYPTION_KEY=
TASK_LOCATION_ENCRYPTION_KEY_ID=
TASK_LOCATION_DECRYPTION_KEYS={}
TAX_TIN_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY=

# The legacy website-to-engine shared write credential is retired. Workload
# commands require a reviewed named service-identity boundary; no replacement
# secret belongs in the general application environment.
INTERNAL_API_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOW_TEST_BYPASS=false
HX_HUMAN_VERIFICATION_MODE=
HX_HUMAN_VERIFICATION_URL=
HX_HUMAN_VERIFICATION_SECRET=
LEAD_PRIVACY_HASH_SALT=
LEAD_RATE_LIMIT_PER_IP_TYPE_HOUR=10
PUBLIC_INGRESS_IP_HASH_SALT=
TASK_DRAFT_RATE_LIMIT_PER_IP_HOUR=20
# Temporary cutover-only reference for SHA-256(ip + legacy salt) rate-limit continuity.
# Remove after the final legacy writer is disabled and its one-hour window has elapsed.
TASK_DRAFT_LEGACY_IP_HASH_SALT=

# Cloudflare R2 / S3-compatible object storage
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hustlexp-media
R2_REGION=auto
# Legacy aliases accepted by config; leave blank when using R2_* names.
S3_ENDPOINT=
BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Optional biometric and screening providers
AWS_REGION=
GOOGLE_CLOUD_VISION_API_KEY=
CHECKR_WEBHOOK_SECRET=

# Maps
GOOGLE_MAPS_API_KEY=

# AI providers and routing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-r1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ALIBABA_API_KEY=
ALIBABA_MODEL=qwen-max
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_ROUTE_PRIMARY=openai
AI_ROUTE_FAST=groq
AI_ROUTE_REASONING=deepseek
AI_ROUTE_SAFETY=anthropic
AI_ROUTE_BACKUP=alibaba
AI_CACHE_TTL=86400

# Outbound communications. The complete local stack supplies these exact
# sink-only values and does not require provider credentials. Leave every live
# provider selector disabled unless a separately approved production release
# explicitly supplies the complete live-provider authority tuple.
HX_OUTBOUND_COMMUNICATION_MODE=sink
HX_EMAIL_DELIVERY_MODE=sink
HX_SMS_DELIVERY_MODE=sink
HX_LIVE_DELIVERY=false
HX_LIVE_PROVIDER_ACCESS=false
HX_EXTERNAL_VALUE=false
SMTP_URL=smtp://localhost:1025
HX_SMS_SINK_URL=http://localhost:8081/v1/messages/sms
# Legacy migration-121 callbacks use the webhook secret. Migration 138 request
# creation and the async SMTP-sink worker both require the configured UUID of
# one active synthetic service actor. Leave both blank outside an explicitly
# configured nonproduction sink lane; neither value enables live delivery.
HX_COMPLETION_DELIVERY_WEBHOOK_SECRET=
HX_COMPLETION_DELIVERY_SINK_ACTOR_ID=

# Existing production provider compatibility (not authority by itself)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_PHONE=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=verify@hustlexp.app

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_FORCE_ENABLE=0
DATADOG_ENABLED=false
DD_AGENT_HOST=localhost
DD_AGENT_PORT=8125
DD_SERVICE=hustlexp-api
DD_ENV=development
DD_VERSION=

# Legacy Seattle beta flags
BETA_ENABLED=false
BETA_START_DATE=
BETA_END_DATE=

# Operator-only certification tooling; not normal runtime configuration
HX_PRODUCTION_ROLE_DATABASE_URL=
HX_DATABASE_TLS_REJECT_UNAUTHORIZED=true
HX_PROD_HEALTH_URL=https://hustlexp-ai-backend-production.up.railway.app/health
HX_EPIC03_SKIP_CONNECT=0
HX_EPIC03_CONNECT_ACCOUNT_ID=

TASK_LOCATION_ENCRYPTION_KEY=
HXOS_ALLOW_LOCAL_TEST_AUTH=true
ENGINE_API_MODE=test
HXOS_LOCAL_TEST_AUTH_SECRET=this-is-a-very-long-random-secret-for-local-testing-123456789
HXOS_ALLOW_LOCAL_TEST_SCREENING=true
HXOS_LOCAL_TEST_SCREENING_SECRET=
