{
  "name": "hustlexp-ai-backend",
  "version": "1.0.0",
  "main": "backend/src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env --watch backend/src/server.ts",
    "dev:workers": "tsx --env-file-if-exists=.env --watch backend/src/jobs/workers.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "compile": "tsc && node scripts/write-build-identity.mjs",
    "start": "if [ \"$SERVICE_ROLE\" = \"worker\" ]; then node dist/backend/src/jobs/workers.js; else node dist/backend/src/server.js; fi",
    "start:dev": "tsx --env-file-if-exists=.env backend/src/server.ts",
    "start:workers": "node dist/backend/src/jobs/workers.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:kill": "DATABASE_URL=$DATABASE_URL vitest run backend/tests/invariants/ --reporter=verbose",
    "test:invariants": "DATABASE_URL=$DATABASE_URL vitest run backend/tests/invariants/ --reporter=verbose",
    "test:all": "vitest run",
    "test:required": "node scripts/run-required-tests.mjs",
    "verify:realtime": "npx tsx scripts/verify-realtime-transport.ts",
    "db:check": "npx tsx --env-file-if-exists=.env scripts/validate-schema.ts",
    "db:migrate": "node -e \"console.error('db:migrate is disabled: it was DESTRUCTIVE (DROP SCHEMA public CASCADE). Dev reset only: npm run db:reset:destructive. To align an existing DB without wiping it, use the reviewed alignment process.'); process.exit(1)\"",
    "db:migrate:nonprod-financial": "node -e \"import('./dist/backend/src/jobs/nonproduction-financial-migration.js').then(async (m) => { const result = await m.runNonproductionFinancialDatabaseBootstrap(); process.stdout.write(JSON.stringify(result.completion)); })\"",
    "db:migrate:apply": "node dist/backend/src/jobs/migration-command.js",
    "db:migrate:local": "tsx --env-file-if-exists=.env backend/src/jobs/migration-command.ts",
    "db:verify:work-order-authority": "node dist/backend/src/jobs/work-order-command-role-authority-command.js",
    "db:migrations:checksum-plan": "tsx scripts/reconcile-legacy-migration-checksums.ts --plan",
    "db:migrations:checksum-apply": "tsx scripts/reconcile-legacy-migration-checksums.ts --apply",
    "db:reset:destructive": "node migrate-pg.mjs",
    "db:validate": "npx tsx --env-file-if-exists=.env scripts/validate-schema.ts",
    "db:migrate:consolidate": "npx tsx scripts/consolidate-migrations.ts",
    "health": "curl http://localhost:3000/health",
    "package:role-fixture-evidence": "node scripts/package-role-fixture-evidence.mjs",
    "verify:alert-inventory": "node scripts/verify-alert-inventory.mjs",
    "verify:consequential-admin": "node scripts/verify-consequential-admin-mutations.mjs",
    "verify:epic03-stripe-test": "node scripts/epic03-stripe-test-cert.mjs",
    "verify:epic03-webhook-replay": "node scripts/epic03-webhook-replay-cert.mjs",
    "lint": "eslint backend/src --ext .ts",
    "lint:fix": "eslint backend/src --ext .ts --fix",
    "format": "prettier --write \"backend/src/**/*.ts\"",
    "format:check": "prettier --check \"backend/src/**/*.ts\"",
    "generate:test-stubs": "tsx scripts/generate-test-stubs.ts",
    "check:tdad": "bash scripts/check-test-coverage-pr.sh",
    "index-docs": "node -e \"throw new Error('EXTERNAL_AI_DURABLE_SPEND_AUTHORITY_REQUIRED:index-docs')\"",
    "query-docs": "node -e \"throw new Error('EXTERNAL_AI_DURABLE_SPEND_AUTHORITY_REQUIRED:query-docs')\"",
    "generate:type-manifest": "tsx scripts/generate-type-manifest.ts",
    "incident-report": "tsx scripts/generate-incident-report.ts",
    "greptile:review": "node -e \"throw new Error('EXTERNAL_AI_DURABLE_SPEND_AUTHORITY_REQUIRED:greptile-pr-review')\"",
    "test:vault": "vitest run 'tests-vault/**/*.test.ts'",
    "test:new": "vitest run 'backend/tests/new/**/*.test.ts'",
    "verify:architecture": "madge backend/src --extensions ts --circular --warning",
    "verify:complexity": "node scripts/verify-complexity.mjs",
    "verify:sast": "uvx semgrep scan --config p/typescript --error --no-git-ignore backend/src",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "verify:supply-chain": "npm audit --audit-level=low && npm run verify:licenses",
    "verify:coverage-diff": "vitest run --coverage --reporter=dot && node scripts/verify-diff-coverage.mjs",
    "verify:mutation": "stryker run stryker.conf.json",
    "verify:properties": "vitest run backend/tests/unit/engine-automation-properties.test.ts backend/tests/unit/pending-payment-cancellation-properties.test.ts --reporter=dot",
    "verify:differential": "vitest run backend/tests/unit/engine-automation-differential.test.ts --reporter=dot",
    "verify:schema": "node scripts/verify-automation-contracts.mjs",
    "verify:build-identity": "node --test scripts/write-build-identity.test.mjs",
    "verify:security-workflow:contract": "node --test scripts/verify-security-workflow.test.mjs",
    "verify:production-role-readiness:contract": "node --test scripts/verify-production-role-readiness.test.mjs",
    "verify:production-role-readiness": "npm run verify:production-role-readiness:contract && node scripts/verify-production-role-readiness.mjs",
    "verify:production-legal-approval:contract": "node --test scripts/verify-production-legal-approval.test.mjs",
    "verify:production-legal-approval": "npm run verify:production-legal-approval:contract && node scripts/verify-production-legal-approval.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "3.994.0",
    "@aws-sdk/client-s3": "^3.999.0",
    "@aws-sdk/s3-request-presigner": "^3.999.0",
    "@hono/node-server": "2.0.11",
    "@hono/trpc-server": "0.4.0",
    "@sendgrid/mail": "8.1.6",
    "@sentry/node": "10.65.0",
    "@trpc/server": "^11.10.0",
    "@upstash/redis": "1.36.1",
    "bullmq": "5.80.1",
    "firebase-admin": "14.1.0",
    "groq-sdk": "0.7.0",
    "hono": "4.13.5",
    "ioredis": "5.9.1",
    "node-statsd": "0.1.1",
    "openai": "4.68.0",
    "pg": "8.16.3",
    "pino": "9.4.0",
    "prom-client": "15.1.3",
    "sharp": "0.35.3",
    "stripe": "20.0.0",
    "twilio": "5.10.7",
    "ws": "8.21.0",
    "zod": "3.23.8"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.11"
    },
    "body-parser": "2.3.0",
    "esbuild": "0.28.1",
    "express-rate-limit": "8.5.2",
    "fast-xml-parser": ">=5.3.8",
    "fast-uri": "3.1.5",
    "flatted": "3.4.2",
    "form-data": ">=4.0.6",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "postcss": "8.5.26",
    "protobufjs": ">=8.5.1",
    "qs": "6.15.3",
    "uuid": "11.1.1",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/twilio": "3.19.2",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@typescript-eslint/typescript-estree": "^8.56.0",
    "@typescript-eslint/utils": "^8.56.0",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "16.4.5",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "^4.5.3",
    "madge": "^8.0.0",
    "pino-pretty": "11.2.2",
    "prettier": "3.8.1",
    "vitest": "4.1.10"
  }
}
